# Default deny: only source, tests and reproducible build configuration belong here.
/*
!/.gitignore
!/.gitattributes
!/README.md
!/pyproject.toml
!/uv.lock
!/package.json
!/package-lock.json
!/scripts/
!/src/
!/tests/
!/frontend/
!/.github/
/.github/*
!/.github/workflows/

# These exclusions apply even inside allowed directories.
**/docs/
**/research/
**/.research/
**/local/
**/data/
**/sessions/
**/cookies/
**/archive/
**/downloads/
**/exports/
**/.env*
**/*credential*
**/*secret*
**/*cookie*
**/*session*.json
**/*.pem
**/*.key
**/*.p12
**/*.pfx
**/*.db*
**/*.sqlite*
**/*.log
**/*.har
**/*.zip
**/*.jpg
**/*.jpeg
**/*.heic
**/*.png
**/*.mov
**/*.mp4
**/*.part
**/node_modules/
**/.venv/
**/venv/
**/__pycache__/
**/*.py[cod]
**/.pytest_cache/
**/.ruff_cache/
**/.mypy_cache/
**/dist/
**/build/
**/*.egg-info/
**/coverage/
**/.coverage*
**/.idea/
**/.vscode/
**/Thumbs.db
**/desktop.ini
